# Server-side encrypted storage key (required in production Cloudflare Secrets)
APP_ENCRYPTION_KEY="REPLACE_WITH_LONG_RANDOM_SERVER_SECRET"

# Optional Cloudflare Runtime Secrets for IUT account
# If set, these take precedence over form-submitted credentials
IUT_USERNAME="40125403"
IUT_PASSWORD=""

# Optional panel access token for extra private protection
PANEL_ACCESS_TOKEN=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
